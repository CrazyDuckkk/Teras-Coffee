# Database (dev: Docker Compose lokal, prod: Supabase)
POSTGRES_USER=teras
POSTGRES_PASSWORD=teras
POSTGRES_DB=teras_coffee

# Dipakai oleh app runtime (drizzle client). Dev: koneksi langsung ke Docker Postgres.
# Prod (Supabase): pakai connection string transaction pooler (port 6543).
DATABASE_URL=postgres://teras:teras@localhost:5432/teras_coffee

# Dipakai khusus oleh drizzle-kit (generate/migrate). Dev: sama seperti DATABASE_URL.
# Prod (Supabase): pakai connection string direct (port 5432, non-pooled).
DIRECT_URL=postgres://teras:teras@localhost:5432/teras_coffee

# Better Auth
BETTER_AUTH_SECRET=ganti-dengan-random-string-panjang
BETTER_AUTH_URL=http://localhost:3000

# Akun owner tunggal (dipakai scripts/seed-owner.ts)
OWNER_EMAIL=owner@teras.coffee
OWNER_PASSWORD=ganti-password-ini
OWNER_NAME=Pemilik Kedai
